{
  "name": "MCP Stack Deploy",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Manus MCP Bridge",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "cd manus-mcp-bridge && python3 -m venv .venv && . .venv/bin/activate && pip install -r requirements.txt",
  "postStartCommand": "bash scripts/start-bridge.sh",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  },
  "remoteEnv": {
    "HOST": "0.0.0.0",
    "PORT": "8000"
  }
}
